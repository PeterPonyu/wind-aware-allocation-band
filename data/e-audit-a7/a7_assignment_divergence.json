    "monkey_patch_source": {
      "RecordingWindyCtrlAviary": "class RecordingWindyCtrlAviary(_ORIG_AVIARY):\n    \"\"\"WindyCtrlAviary that exposes the current true wind vector to the Hungarian wrapper.\n\n    Physics are untouched: only ``set_wind_vec`` / ``__init__`` are extended to copy the\n    vector into ``_A7_STATE`` so the wrapper can compute the counterfactual penalised\n    assignment in the baseline arm (which never sees a wind estimate).\n    \"\"\"\n\n    def __init__(self, *args, wind_vec=(0.0, 0.0, 0.0), **kwargs):\n        _A7_STATE[\"true_wind\"] = np.asarray(wind_vec, dtype=float).copy()\n        super().__init__(*args, wind_vec=wind_vec, **kwargs)\n\n    def set_wind_vec(self, wind_vec):\n        super().set_wind_vec(wind_vec)\n        _A7_STATE[\"true_wind\"] = np.asarray(wind_vec, dtype=float).copy()\n",
      "apply_patches": "def apply_patches(cell: dict[str, Any]) -> None:\n    \"\"\"Install/restore the module-level replacements requested by one cell.\"\"\"\n    if cell.get(\"patch_controller\"):\n        run_experiment.DSLPIDControl = make_patched_controller(\n            float(cell.get(\"ki_xy\", STOCK_KI_XY)), float(cell.get(\"clamp_xy\", STOCK_CLAMP_XY)))\n    else:\n        run_experiment.DSLPIDControl = _STOCK_CONTROLLER\n    run_experiment.DURATION_SEC = float(cell.get(\"duration_s\", _ORIG_DURATION))\n    if cell.get(\"record_assignment\"):\n        run_experiment.hungarian_assign = hungarian_assign_logged\n        run_experiment.WindyCtrlAviary = RecordingWindyCtrlAviary\n    else:\n        run_experiment.hungarian_assign = _ORIG_HUNGARIAN\n        run_experiment.WindyCtrlAviary = _ORIG_AVIARY\n    if cell.get(\"save_trajectory\"):\n        os.environ[\"FIRE_SAVE_TRAJECTORY\"] = \"1\"\n    else:\n        os.environ.pop(\"FIRE_SAVE_TRAJECTORY\", None)\n",
      "hungarian_assign_logged": "def hungarian_assign_logged(drone_pos, targets, unfinished_drones, unfinished_targets,\n                            wind_vec=None, wind_penalty=0.0):\n    \"\"\"Drop-in replacement for run_experiment.hungarian_assign that logs three solutions.\n\n    ``used``            the assignment the frozen code actually consumes (identical call);\n    ``euclid``          the Euclidean-only assignment at the same positions;\n    ``penalised_true``  the lambda = 0.25 m/N penalised assignment using the TRUE wind vector.\n    In the wind-aware oracle arm ``used == penalised_true``; in the baseline ``used == euclid``.\n    \"\"\"\n    used = _ORIG_HUNGARIAN(drone_pos, targets, unfinished_drones, unfinished_targets,\n                           wind_vec=wind_vec, wind_penalty=wind_penalty)\n    euclid = _ORIG_HUNGARIAN(drone_pos, targets, unfinished_drones, unfinished_targets,\n                             wind_vec=None, wind_penalty=0.0)\n    true_wind = _A7_STATE[\"true_wind\"]\n    penalised_true = _ORIG_HUNGARIAN(drone_pos, targets, unfinished_drones, unfinished_targets,\n                                     wind_vec=true_wind, wind_penalty=ASSIGNMENT_PENALTY_M_PER_N)\n    ud = list(unfinished_drones)\n    ut = list(unfinished_targets)\n    dist, pen = _cost_matrices(drone_pos, targets, ud, ut, true_wind, ASSIGNMENT_PENALTY_M_PER_N)\n    eu_costs = _sorted_perm_costs(dist)\n    gap = (eu_costs[1] - eu_costs[0]) if len(eu_costs) > 1 else None\n    _A7_STATE[\"log\"].append({\n        \"call_index\": len(_A7_STATE[\"log\"]),\n        \"n_unfinished\": len(ud),\n        \"unfinished_drones\": [int(x) for x in ud],\n        \"used\": {str(int(k)): int(v) for k, v in used.items()},\n        \"euclid\": {str(int(k)): int(v) for k, v in euclid.items()},\n        \"penalised_true\": {str(int(k)): int(v) for k, v in penalised_true.items()},\n        \"used_differs_from_euclid\": any(used[d] != euclid[d] for d in ud),\n        \"penalised_true_differs_from_euclid\": any(penalised_true[d] != euclid[d] for d in ud),\n        \"euclid_best_minus_second_best_m\": gap,\n        \"max_penalty_m\": float(pen.max()) if pen.size else 0.0,\n        \"true_wind_mag_N\": float(np.linalg.norm(true_wind)) if true_wind is not None else None,\n    })\n    return used\n",
      "make_patched_controller": "def make_patched_controller(ki_xy: float, clamp_xy: float):\n    \"\"\"Return a DSLPIDControl subclass with a different horizontal integral gain / clamp.\n\n    Only the xy entries of ``I_COEFF_FOR`` and the +-2 m s xy integral clamp are changed;\n    the z channel (Ki 0.05, clamp +-0.15) and every other coefficient are stock.  With\n    ``ki_xy=0.05, clamp_xy=2.0`` the arithmetic is identical to the stock class (verified\n    bit-for-bit against the bound primary sweep in a1_gain_sweep.py).\n    \"\"\"\n\n    class AuditDSLPIDControl(_STOCK_CONTROLLER):\n        KI_XY = float(ki_xy)\n        CLAMP_XY = float(clamp_xy)\n\n        def __init__(self, drone_model, g: float = 9.8):\n            super().__init__(drone_model=drone_model, g=g)\n            self.I_COEFF_FOR = np.array([self.KI_XY, self.KI_XY, .05])\n\n        def _dslPIDPositionControl(self,\n                                   control_timestep,\n                                   cur_pos,\n                                   cur_quat,\n                                   cur_vel,\n                                   target_pos,\n                                   target_rpy,\n                                   target_vel\n                                   ):\n            # Verbatim copy of DSLPIDControl._dslPIDPositionControl (L187-L208 of the\n            # frozen file) with the literal +-2. xy clamp replaced by self.CLAMP_XY.\n            cur_rotation = np.array(p.getMatrixFromQuaternion(cur_quat)).reshape(3, 3)\n            pos_e = target_pos - cur_pos\n            vel_e = target_vel - cur_vel\n            self.integral_pos_e = self.integral_pos_e + pos_e*control_timestep\n            self.integral_pos_e = np.clip(self.integral_pos_e, -self.CLAMP_XY, self.CLAMP_XY)\n            self.integral_pos_e[2] = np.clip(self.integral_pos_e[2], -0.15, .15)\n            #### PID target thrust #####################################\n            target_thrust = np.multiply(self.P_COEFF_FOR, pos_e) \\\n                            + np.multiply(self.I_COEFF_FOR, self.integral_pos_e) \\\n                            + np.multiply(self.D_COEFF_FOR, vel_e) + np.array([0, 0, self.GRAVITY])\n            scalar_thrust = max(0., np.dot(target_thrust, cur_rotation[:,2]))\n            thrust = (math.sqrt(scalar_thrust / (4*self.KF)) - self.PWM2RPM_CONST) / self.PWM2RPM_SCALE\n            target_z_ax = target_thrust / np.linalg.norm(target_thrust)\n            target_x_c = np.array([math.cos(target_rpy[2]), math.sin(target_rpy[2]), 0])\n            target_y_ax = np.cross(target_z_ax, target_x_c) / np.linalg.norm(np.cross(target_z_ax, target_x_c))\n            target_x_ax = np.cross(target_y_ax, target_z_ax)\n            target_rotation = (np.vstack([target_x_ax, target_y_ax, target_z_ax])).transpose()\n            #### Target rotation #######################################\n            target_euler = (Rotation.from_matrix(target_rotation)).as_euler('XYZ', degrees=False)\n            if np.any(np.abs(target_euler) > math.pi):\n                print(\"\\n[ERROR] ctrl it\", self.control_counter, \"in Control._dslPIDPositionControl(), values outside range [-pi,pi]\")\n            return thrust, target_euler, pos_e\n\n    AuditDSLPIDControl.__name__ = f\"AuditDSLPIDControl_ki{ki_xy}_clamp{clamp_xy}\"\n    return AuditDSLPIDControl\n",
      "run_cell": "def run_cell(cell: dict[str, Any]) -> dict[str, Any]:\n    \"\"\"Run one episode of the frozen code under the patches described by ``cell``.\"\"\"\n    apply_patches(cell)\n    _A7_STATE[\"log\"] = []\n    _A7_STATE[\"true_wind\"] = None\n    t0 = time.perf_counter()\n    # BaseAviary prints its URDF parameters on every construction; keep worker stdout quiet.\n    with contextlib.redirect_stdout(io.StringIO()):\n        row = run_experiment.run_episode(\n            str(cell[\"treatment\"]),\n            float(cell[\"force_N\"]),\n            int(cell[\"seed\"]),\n            num_drones=4,\n            gui=False,\n            success_radius_m=cell.get(\"radius_m\"),\n            record_per_drone_metrics=True,\n            record_safety_metrics=bool(cell.get(\"safety\", False)),\n        )\n    row[\"wall_clock_sec\"] = time.perf_counter() - t0\n    row[\"cell\"] = {k: v for k, v in cell.items()}\n    row[\"controller\"] = (\n        {\"class\": \"stock DSLPIDControl\", \"ki_xy\": STOCK_KI_XY, \"clamp_xy\": STOCK_CLAMP_XY}\n        if not cell.get(\"patch_controller\")\n        else {\"class\": run_experiment.DSLPIDControl.__name__,\n              \"ki_xy\": float(cell.get(\"ki_xy\", STOCK_KI_XY)),\n              \"clamp_xy\": float(cell.get(\"clamp_xy\", STOCK_CLAMP_XY))}\n    )\n    if cell.get(\"record_assignment\"):\n        row[\"assignment_log\"] = list(_A7_STATE[\"log\"])\n    return row\n"
    },
